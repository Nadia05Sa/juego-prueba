  id: lapida_fundador
  title: "L\xE1pida del fundador"
  body: "AQU\xCD DESCANSA\n\n<b>DON IGNACIO\nDE LA VEGA</b>\nFundador de esta hacienda\n1841 \u2013 1898\n\n--------------------\n\nDebajo, raspado:\n<color=#3A2A1A>Hizo un trato que no fue suyo.\nQue no despierte.</color>"
  isClue: 0
