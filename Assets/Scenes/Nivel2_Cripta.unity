  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.9, g: 0.82, b: 0.72, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 24
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "WASD / Flechas \u2014 Moverse\nShift \u2014 Correr (hace m\xE1s ruido)\nE \u2014 Interactuar (puertas, notas, objetos)\nQ \u2014 Esconderse (cerca de un escondite)\nI / Tab \u2014 Abrir el inventario\nEsc \u2014 Pausar\n\nLee las cartas y busca pistas.\nSi algo te persigue: corre o esc\xF3ndete.\nNo intentes pelear: solo puedes escapar.\n\nOrden de exploraci\xF3n:\n1) Capilla \u2192 sacrist\xEDa (puerta a la derecha del altar).\n2) Lee las 2 hojas y gira el torno (abre la reja).\n3) Baja a las criptas: s\xEDmbolos en orden Sol \u2192 Luna \u2192 Espiral \u2192 Calavera.\n4) C\xE1mara: toma la mitad del medall\xF3n y sube la escalera.\n\nEvita las cadenas del techo. Q para esconderte si te persiguen."
